# Log level: info | warn | error (any other value = debug)
LOG_LEVEL=info

# HTTP server host and port
SERVER_HOST=localhost
SERVER_PORT=8080

# MCP server port
MCP_PORT=8060

# Required: token clients use to authenticate to this server
MCP_AUTH_TOKEN=change-me

# HTTP path the MCP endpoint is served under
MCP_BASE_PATH=/mcp/health

# Required: Google OAuth client credentials
OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-client-secret

# Must match an authorized redirect URI in Google Cloud Console
OAUTH_REDIRECT_URL=http://localhost:8080/oauth/callback

# Comma-separated OAuth scopes (replace with the Health API scopes you need)
OAUTH_SCOPES=https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly,https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly,https://www.googleapis.com/auth/googlehealth.location.readonly,https://www.googleapis.com/auth/googlehealth.nutrition.readonly,https://www.googleapis.com/auth/googlehealth.sleep.readonly,https://www.googleapis.com/auth/googlehealth.reproductive_health.readonly,https://www.googleapis.com/auth/googlehealth.logged_symptoms.readonly,https://www.googleapis.com/auth/googlehealth.mindfulness.readonly,https://www.googleapis.com/auth/googlehealth.profile.readonly,https://www.googleapis.com/auth/googlehealth.irn.readonly,https://www.googleapis.com/auth/googlehealth.ecg.readonly

# Where the OAuth token is stored (mount a volume here in Docker)
OAUTH_TOKEN_FILE=token.json
